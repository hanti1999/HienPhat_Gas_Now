{
  "expo": {
    "name": "HienPhatGasNow",
    "slug": "hienphatgasnow",
    "version": "25.03.27",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nthanh99.hienphatgasnow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.nthanh99.hienphatgasnow",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép ứng dụng sử dụng vị trí của bạn?",
          "locationAlwaysPermission": "Cho phép ứng dụng sử dụng vị trí của bạn?",
          "locationWhenInUsePermission": "Cho phép ứng dụng sử dụng vị trí của bạn?"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng truy cập máy ảnh của bạn?",
          "microphonePermission": "Cho phép ứng dụng truy cập microphone của bạn?",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8b33327d-5a6e-4628-a053-880477ed3c7d"
      }
    }
  }
}
